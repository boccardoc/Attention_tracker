# Reddit API credentials (free "script" app: https://www.reddit.com/prefs/apps)
# Copy to .env and fill in. NEVER commit the real .env.
REDDIT_CLIENT_ID=your_client_id
REDDIT_CLIENT_SECRET=your_client_secret
REDDIT_USER_AGENT=attention-monitor/1.0 by u/yourname

# Optional: override the shared SQLite path (default: <repo>/data/attention.db)
# ATTENTION_DB=/absolute/path/to/attention.db
